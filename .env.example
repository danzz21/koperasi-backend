APP_NAME="Koperasi Syariah K-Samara"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database_koperasi
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SANCTUM (untuk auth token)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# CORS
FRONTEND_URL=http://localhost:5173

# ── Payment Gateway (Midtrans) ───────────────────────────────────────────
# Topup E-Wallet otomatis (QRIS / Virtual Account) aktif setelah SERVER_KEY
# diisi key live. Daftarkan URL notifikasi di dashboard Midtrans:
#   https://domain-anda.com/api/payment/midtrans/notify
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ENABLED=true
MIDTRANS_API_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_SNAP_JS=https://app.sandbox.midtrans.com/snap/snap.js

# Rekening koperasi untuk topup manual
KOPERASI_BANK=BCA
KOPERASI_REKENING=
KOPERASI_REKENING_ATAS="Koperasi K-Samara"


# ── Topup E-Wallet ───────────────────────────────────────────────────────
# true  → unggah bukti transfer langsung menambah saldo (tanpa approval admin)
# false → saldo menunggu verifikasi admin (default, lebih aman)
# Topup QRIS / Virtual Account selalu otomatis lewat webhook Midtrans.
TOPUP_AUTO_APPROVE_MANUAL=false


# Google OAuth (login anggota via Google Identity Services)
# Buat OAuth Client ID bertipe "Web application" di Google Cloud Console dan
# daftarkan origin frontend (mis. http://localhost:5173) sebagai Authorized
# JavaScript origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# WebAuthn / Passkey (login biometrik)
# rp_id = host frontend tanpa skema/port (localhost untuk dev). Kosongkan agar
# otomatis diambil dari header Origin. Untuk produksi, isi mis. app.domain.com
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME="K-Samara"
# Origin frontend yang diizinkan, pisahkan dengan koma. Kosong = otomatis.
WEBAUTHN_ORIGINS=
WEBAUTHN_REQUIRE_UV=true

